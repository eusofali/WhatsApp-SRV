# =============================================================================
# WhatsApp-SRV (OpenWA) - production .env
# Copy to the OpenWA checkout as ".env":   cp .env.production.example /opt/openwa/.env
# Then fill in every CHANGE_ME value. Keep this file private (chmod 600).
# Only settings that matter for a first deployment are listed. The full list is in
# OpenWA's own .env.example. NOTE: a value present here PINS that setting and
# overrides the dashboard (Dashboard > Infrastructure), so keep this file short.
# =============================================================================

NODE_ENV=production
PORT=2785
LOG_LEVEL=info
TZ=UTC

# ---- Public URLs / CORS ------------------------------------------------------
# Your public HTTPS URL (the reverse proxy / cPanel subdomain).
BASE_URL=https://wa.example.com
# Browser origins allowed to call the API. "*" is REFUSED in production.
CORS_ORIGINS=https://wa.example.com

# ---- Reverse proxy -----------------------------------------------------------
# Needed so rate limits and per-key IP allowlists see the real client IP.
#   bare-metal / systemd + nginx/Apache/Caddy on the same machine : 127.0.0.1
#   Docker Compose (published port goes through the bridge NAT)   : 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1

# ---- Security ----------------------------------------------------------------
# First-boot ADMIN key (>= 32 chars). Generate:  openssl rand -base64 32 | tr -d '\n='
# Only read when no key exists yet. Changing it later does nothing.
API_MASTER_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
# Hash pepper for API keys. Generate:  openssl rand -hex 32
# MUST be set BEFORE the first boot. Setting or changing it later locks out every key.
API_KEY_PEPPER=CHANGE_ME_RANDOM_HEX

# ---- WhatsApp engine ---------------------------------------------------------
# whatsapp-web.js : headless Chromium, ~300-500 MB RAM per session, lower ban risk.
# baileys         : no browser, light RAM, higher ban risk.
# Shared hosting (no root) MUST use baileys. VPS: either.
ENGINE_TYPE=whatsapp-web.js

# Cap concurrent sessions so a small server cannot be exhausted (0 = unlimited).
MAX_CONCURRENT_SESSIONS=2
# Re-connect linked sessions after a restart (single instance only).
AUTO_START_SESSIONS=true

# ---- Database / storage (defaults are fine for a single node) ----------------
# SQLite is the default and needs nothing here. For PostgreSQL uncomment & fill:
# DATABASE_TYPE=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=openwa
# DATABASE_USERNAME=openwa
# DATABASE_PASSWORD=CHANGE_ME
DATABASE_SYNCHRONIZE=false

# ---- Uploads -----------------------------------------------------------------
# Keep the proxy's client_max_body_size >= this value.
# BODY_SIZE_LIMIT=25mb
